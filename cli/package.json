{
  "name": "vibeprompt",
  "version": "0.1.0",
  "description": "CLI for browsing and running vibeprompt prompts from the terminal",
  "type": "module",
  "bin": {
    "vibeprompt": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.tsx src/tui.tsx --format esm --dts",
    "dev": "tsx src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "clipboardy": "^5.3.2",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.31",
    "@types/yargs": "^17.0.32",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
